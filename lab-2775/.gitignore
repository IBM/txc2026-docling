# Your own configuration, and what the bootstrap writes from the instructors'
# file for this VM: workshop.yaml (your password, the Kafka secret) and the
# broker CA that came inline in it.
lab.yaml
workshop.yaml
certs/kafka-ca.crt

# Virtualenvs. The dashboard gets its own so a Streamlit upgrade can never move
# something the pipeline depends on.
.venv/
.venv-dashboard/

__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# Fetched by scripts/fetch_jars.sh, only needed to build the pipeline image.
jars/*.jar
