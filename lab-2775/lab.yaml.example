# LAB-2775 — your configuration. The bootstrap makes `lab.yaml` from this.
#
#     ./setup.sh check
#
# The workshop's values — your student id, your OpenSearch password, the
# brokers, the Flink control plane, watsonx.ai — are not in this file. The
# instructors put them on your VM, and the bootstrap copied them into
# `workshop.yaml` beside this one; the line below is what reads them. Open it
# if you are curious, but do not edit it: the next bootstrap run replaces it.
#
# The three values you add yourself are marked YOU; each says which phase of
# the lab produces it. Anything else you set here wins over workshop.yaml — it
# has the same sections and keys — but on the lab VM you should not need to.
#
# Everything you own — five Kafka topics, a Flink application, a consumer
# group, an OpenSearch account and its index — is *derived* from your student
# id. That is not tidiness: two students sharing a consumer group makes Kafka
# split the partitions between them, so most of the class sees no data at all,
# from a pipeline that looks perfectly healthy.
#
# Not on the lab VM? Delete the include line and copy the sections of
# workshop.yaml.example in here instead.
include: workshop.yaml

student:
  # YOU (Phase 2) — the CRN of the bucket you create in the IBM Cloud console.
  # There is a copy button beside it on the bucket's Configuration tab. It is
  # also the last word on your bucket's *name*: names are globally unique
  # across all of IBM Cloud, so if the suggested one was taken and you made a
  # different one, the CRN is where that shows up. Leave it empty and the
  # dashboard simply shows no bucket link.
  bucket_crn: ""

docling:
  # YOU (Phase 1) — your own Docling trial. `url` is the *service* URL, which
  # is not the address in your browser's bar: that one is the workbench. They
  # are one instance under two hostnames and only the service URL works, so it
  # is the only one to paste — the dashboard works the workbench link back out
  # of it when it wants to link there.
  url: ""
  api_key: ""
